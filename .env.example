# Von @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Deine eigene Telegram-User-ID (z. B. über @userinfobot). Nur diese ID bekommt Antworten.
TELEGRAM_ALLOWED_USER_ID=
# Anthropic-API-Key aus https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional: Kostenobergrenze pro Unterhaltung in US-Cent (200 = $2)
SESSION_BUDGET_CENTS=200
# Optional: Ordner für IDs und Sitzungen (Standard: ./state)
SNOW_BOT_STATE_DIR=

# --- Gratis-Modus (/free) und automatischer Ersatz, wenn Claude ausfällt ---
# Optional. Ohne diese Keys gibt es /free nicht. Reihenfolge: erst Cerebras, dann GitHub.
# Key von https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Optional, Standard: gpt-oss-120b (Alternative: qwen-3.8-27b)
CEREBRAS_MODEL=
# GitHub Fine-grained Token, nur Berechtigung "Models: read" (https://github.com/settings/personal-access-tokens)
GITHUB_MODELS_TOKEN=
# Optional, Standard: openai/gpt-4.1-mini
GITHUB_MODELS_MODEL=
